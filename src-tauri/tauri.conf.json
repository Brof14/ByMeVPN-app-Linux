{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByMeVPN",
  "version": "1.2.1",
  "identifier": "space.parahin.bymevpn.linux",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "bash scripts/restore-ui-assets.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ByMeVPN",
        "width": 1320,
        "height": 850,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "bymevpn"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "shortDescription": "ByMeVPN for Linux",
    "longDescription": "ByMeVPN desktop VPN client for Linux"
  }
}
